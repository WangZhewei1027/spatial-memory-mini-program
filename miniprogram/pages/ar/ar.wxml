<ar-shell items="{{bottomNavItems}}" active="{{activeBottomPanel}}" expanded="{{bottomPanelExpanded}}" keyboard-height="{{keyboardHeight}}" bind:panelchange="onPanelChange">
  <xr-start slot="scene" disable-scroll id="main-frame" width="{{renderWidth}}" height="{{renderHeight}}" style="width:{{width}}px;height:{{height}}px;"
    bind:mapconfigload="onMapConfigLoad" bind:activitiesload="onActivitiesLoad" bind:recognitionstatus="onRecognitionStatus"
    bind:matchprogress="onMatchProgress" bind:renderstatus="onRenderStatus" bind:asseterror="onAssetError" />

  <ar-debug-bar slot="top" items="{{debugItems}}" />

  <image slot="overlay" wx:if="{{footerEnabled}}" class="ar-top-logo" src="/assets/DHL-Outlined.png" mode="aspectFit" />
  <ar-shop-overlays slot="overlay" navigation="{{shopNavigation}}" reward="{{shopReward}}" bind:moduleaction="onModuleAction" />

  <ar-recognition-panel slot="bottom" active="{{bottomPanelExpanded && activeBottomPanel === 'recognition'}}" status="{{recognitionStatus}}" bind:moduleaction="onModuleAction" />
  <ar-danmaku-panel slot="bottom" active="{{bottomPanelExpanded && activeBottomPanel === 'danmaku'}}"
    activity="{{activeDanmaku}}" activities="{{danmakuActivities}}" selected="{{selectedDanmakuIdx}}" submitting="{{isSubmitting}}"
    text="{{textContent}}" limit="{{danmakuLimit}}" loading="{{activitiesLoading}}" error="{{activitiesError}}"
    ready="{{mapConfigReady}}" in-range="{{danmakuInRange}}" located="{{!!location}}" can-submit="{{canSubmit}}" bind:moduleaction="onModuleAction" />
  <shop-checkin slot="bottom" wx:if="{{mapConfigReady && shopCheckinEnabled}}" id="shop-checkin" activities="{{shopActivities}}"
    visible="{{showShopPanel}}" panel-collapsed="{{activeBottomPanel !== 'shop' || !bottomPanelExpanded}}"
    location="{{location}}" compass-heading="{{compassHeading}}" bind:moduleaction="onModuleAction" />
</ar-shell>
