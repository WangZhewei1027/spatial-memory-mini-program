@import "../../styles/tabs.wxss";

.scene-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 24rpx;
}

.scene-list .scene-card {
  width: 100%;
  min-width: 0;
  max-width: none;
  margin: 0;
  overflow: hidden;
  padding: 0;
  box-sizing: border-box;
  border-radius: 24rpx;
  background: #2a2a2a;
  color: #e8e8e8;
  text-align: left;
  line-height: 1.4;
}

.scene-list .scene-card-pressed {
  background: #333333;
}

.scene-cover {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  aspect-ratio: 16 / 9;
  background: #313a31;
}

.cover-image {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
}

.cover-mark {
  width: 60rpx;
  height: 60rpx;
  border: 14rpx solid #8fbc8f;
  border-radius: 50%;
  box-sizing: border-box;
}

.scene-details {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  min-height: 88rpx;
  padding: 18rpx 24rpx;
  box-sizing: border-box;
}

.scene-name {
  min-width: 0;
  font-size: 30rpx;
  font-weight: 500;
  overflow-wrap: anywhere;
}

.skeleton {
  background: #383838;
}

.skeleton-name {
  width: 55%;
  height: 28rpx;
  border-radius: 6rpx;
}

.more-scenes {
  margin: 32rpx auto 0;
}
