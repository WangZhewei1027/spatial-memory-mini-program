<view class="tab-content">
  <view class="tab-heading" role="heading">公共场景</view>

  <view class="scene-list" wx:if="{{scenes.length}}">
    <button
      wx:for="{{scenes}}"
      wx:key="id"
      class="scene-card"
      hover-class="scene-card-pressed"
      data-id="{{item.id}}"
      bindtap="onOpenScene"
    >
      <view class="scene-cover">
        <image
          wx:if="{{item.cover}}"
          class="cover-image"
          src="{{item.cover}}"
          mode="aspectFill"
          lazy-load
          data-id="{{item.id}}"
          data-cover="{{item.cover}}"
          binderror="onCoverError"
          aria-hidden="{{true}}"
        />
        <view wx:else class="cover-mark" aria-hidden="{{true}}"></view>
      </view>
      <view class="scene-details">
        <text class="scene-name">{{item.name}}</text>
        <view class="list-arrow" aria-hidden="{{true}}"></view>
      </view>
    </button>
  </view>

  <view wx:if="{{loading && !scenes.length}}" class="scene-list" aria-label="正在加载公共场景">
    <view wx:for="{{[1, 2]}}" wx:key="*this" class="scene-card">
      <view class="scene-cover skeleton"></view>
      <view class="scene-details"><view class="skeleton skeleton-name"></view></view>
    </view>
  </view>
  <view wx:elif="{{error}}" class="tab-message">
    <text>公共场景加载失败</text>
    <button class="tab-action" bindtap="retryScenes">重试</button>
  </view>
  <view wx:elif="{{!scenes.length}}" class="tab-message">
    <text>暂无公共场景</text>
  </view>
  <button
    wx:elif="{{hasMore}}"
    class="tab-action more-scenes"
    disabled="{{loading}}"
    bindtap="loadMoreScenes"
  >{{loading ? '正在加载…' : '加载更多'}}</button>
</view>
