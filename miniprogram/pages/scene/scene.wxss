.scene-preview { position: fixed; inset: 0; width: 100%; height: 100%; background: #111; }
xr-start { display: block; }
.place-button {
  position: absolute;
  bottom: calc(32px + env(safe-area-inset-bottom));
  left: 50%;
  transform: translateX(-50%);
  min-width: 180px;
  margin: 0;
  padding: 0 28px;
  border-radius: 28px;
  background: #8fbc8f;
  color: #142014;
  font-size: 16px;
  font-weight: 600;
  line-height: 52px;
}
.place-button::after { border: none; }
.place-button[disabled] { background: rgba(31, 31, 31, 0.8); color: #b8b8b8; }

.transport {
  position: absolute;
  z-index: 1;
  bottom: calc(24px + env(safe-area-inset-bottom));
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 12px;
}

.transport .transport-button {
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 52px;
  height: 52px;
  margin: 0;
  padding: 0;
  border-radius: 50%;
  background: #2a2a2a;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.25);
}

.transport .transport-play { background: #8fbc8f; }
.transport-button::after { border: none; }
.transport .transport-pressed { opacity: 0.8; }
.transport-icon { width: 24px; height: 24px; }
