@import "../../styles/ar-theme.wxss";
/* ===== 打卡弹窗 ===== */
.checkin-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  background: rgba(0, 0, 0, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
}
.checkin-modal {
  width: 600rpx;
  background: #222;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.checkin-modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 28rpx;
}
.checkin-modal-img {
  width: 520rpx;
  height: 520rpx;
  border-radius: 16rpx;
  margin-bottom: 32rpx;
  background: rgba(255, 255, 255, 0.05);
}
.checkin-modal-actions {
  display: flex;
  gap: 24rpx;
  width: 100%;
}
.checkin-save-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 40rpx;
  background: var(--ar-accent);
  color: #1a1a1a;
  font-size: 28rpx;
  font-weight: 600;
}
.checkin-save-btn:active {
  opacity: 0.8;
}
.checkin-close-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.12);
  color: #fff;
  font-size: 28rpx;
}
.checkin-close-btn:active {
  opacity: 0.7;
}

/* ===== 导航方向覆层 ===== */
.nav-overlay {
  position: fixed;
  top: calc(var(--ar-debug-height) + 24rpx);
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 90;
  pointer-events: none;
}

.nav-compass-ring {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(143, 188, 143, 0.55);
  background: rgba(0, 0, 0, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-arrow-wrap {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: transform 0.2s ease-out;
}

.nav-arrow-head {
  width: 0;
  height: 0;
  border-left: 14rpx solid transparent;
  border-right: 14rpx solid transparent;
  border-bottom: 28rpx solid var(--ar-accent);
}

.nav-arrow-tail {
  width: 6rpx;
  height: 18rpx;
  background: var(--ar-accent);
  border-radius: 0 0 4rpx 4rpx;
  opacity: 0.7;
}

.nav-info-row {
  margin-top: 14rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(0, 0, 0, 0.8);
  border-radius: 32rpx;
  padding: 8rpx 28rpx;
  border: 1rpx solid rgba(143, 188, 143, 0.3);
}

.nav-shop-name {
  color: #fff;
  font-size: 26rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.nav-dist {
  color: var(--ar-accent);
  font-size: 22rpx;
  margin-top: 4rpx;
}
