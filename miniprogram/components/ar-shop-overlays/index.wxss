@import "../../styles/ar-theme.wxss";
/* ===== 打卡弹窗 ===== */
.checkin-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 200;
  background: rgba(0, 0, 0, 0.65);
  display: flex;
  align-items: center;
  justify-content: center;
}
.checkin-modal {
  width: 600rpx;
  background: #222;
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.checkin-modal-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 28rpx;
}
.checkin-modal-img {
  width: 520rpx;
  height: 520rpx;
  border-radius: 16rpx;
  margin-bottom: 32rpx;
  background: rgba(255, 255, 255, 0.05);
}
.checkin-modal-actions {
  display: flex;
  gap: 24rpx;
  width: 100%;
}
.checkin-save-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 40rpx;
  background: var(--ar-accent);
  color: #1a1a1a;
  font-size: 28rpx;
  font-weight: 600;
}
.checkin-save-btn:active {
  opacity: 0.8;
}
.checkin-close-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  border-radius: 40rpx;
  background: rgba(255, 255, 255, 0.12);
  color: #fff;
  font-size: 28rpx;
}
.checkin-close-btn:active {
  opacity: 0.7;
}
