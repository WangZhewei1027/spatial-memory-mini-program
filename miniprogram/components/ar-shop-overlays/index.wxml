<view class="ar-theme">
<!-- 导航方向覆层 -->
<view class="nav-overlay" wx:if="{{navigation.visible}}">
  <view class="nav-compass-ring">
    <view class="nav-arrow-wrap" style="transform: rotate({{navigation.angle}}deg)">
      <view class="nav-arrow-head"></view>
      <view class="nav-arrow-tail"></view>
    </view>
  </view>
  <view class="nav-info-row">
    <text class="nav-shop-name">{{navigation.title}}</text>
    <text class="nav-dist">{{navigation.distance}}</text>
  </view>
</view>

<!-- 打卡成功弹窗 -->
<view class="checkin-mask" wx:if="{{reward.visible}}" bindtap="onClose">
  <view class="checkin-modal" catchtap="">
    <text class="checkin-modal-title">{{reward.title}} · 打卡成功</text>
    <image wx:if="{{reward.image}}" class="checkin-modal-img" src="{{reward.image}}" mode="aspectFit" />
    <view class="checkin-modal-actions">
      <view wx:if="{{reward.image}}" class="checkin-save-btn" bindtap="onSave">保存到相册</view>
      <view class="checkin-close-btn" bindtap="onClose">关闭</view>
    </view>
  </view>
</view>

</view>
