@import "../../styles/ar-panel.wxss";
.recognition-panel { position: relative; border-radius: 24rpx 24rpx 0 0; }
/* Draw entirely inside the panel: no layout shift, hit target, or navbar cue. */
.recognition-hint-border {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  border-radius: inherit;
  box-shadow: inset 0 0 0 3rpx var(--ar-accent);
  pointer-events: none;
  opacity: 0.8;
  animation: recognition-border-pulse 1.6s ease-in-out infinite;
}
@keyframes recognition-border-pulse {
  0%, 100% { opacity: 0.25; }
  50% { opacity: 1; }
}
@media (prefers-reduced-motion: reduce) {
  .recognition-hint-border { animation: none; opacity: 0.8; }
}
