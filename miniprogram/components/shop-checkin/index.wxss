/* ===== 店铺卡片 Swiper ===== */
.shop-swiper-wrap {
  width: 100%;
  padding: 12rpx 0;
}

.shop-progress {
  padding: 0 32rpx 8rpx;
}

.shop-progress-text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

.shop-swiper {
  width: 100%;
  height: 200rpx;
}

.shop-loading {
  color: rgba(255, 255, 255, 0.5);
  font-size: 26rpx;
  padding: 32rpx 40rpx;
}

/* ===== 店铺卡片（横向布局） ===== */
.shop-card {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  margin: 0 12rpx;
  height: 180rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: rgba(30, 30, 30, 0.65);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  transition:
    box-shadow 0.3s,
    transform 0.3s;
  transform: scale(0.9);
  box-sizing: border-box;
}
.shop-card.selected {
  box-shadow:
    0 0 24rpx rgba(255, 255, 255, 0.4),
    0 4rpx 20rpx rgba(0, 0, 0, 0.3);
  transform: scale(1);
}

.shop-card-img {
  width: 180rpx;
  height: 180rpx;
  flex-shrink: 0;
  border-radius: 16rpx 0 0 16rpx;
}

.shop-card-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 12rpx 16rpx 12rpx 20rpx;
  white-space: normal;
  min-width: 0;
  overflow: hidden;
}

.shop-card-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 6rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.shop-card-desc {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.55);
  line-height: 1.4;
  flex: 1;
}

.shop-card-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 8rpx;
}

.shop-card-dist {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.7);
}

.shop-checkin-btn {
  text-align: center;
  font-size: 22rpx;
  border-radius: 24rpx;
  padding: 8rpx 28rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.shop-checkin-btn.active {
  background: #00e676;
  color: #1a1a1a;
}
.shop-checkin-btn.disabled {
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.35);
}
.shop-checkin-btn.checked-in {
  background: rgba(0, 230, 118, 0.18);
  color: #00e676;
  border: 1rpx solid rgba(0, 230, 118, 0.4);
}
.shop-checkin-btn.checked-in:active {
  opacity: 0.8;
}
.shop-checkin-btn.active:active {
  opacity: 0.8;
}

.shop-activity-picker, .shop-activity-title { display: block; padding: 16rpx 28rpx; font-size: 28rpx; color: #fff; }
.shop-activity-picker { min-height: 64rpx; line-height: 64rpx; text-decoration: underline; }
.shop-progress-retry { margin: 8rpx 28rpx; padding: 8rpx 16rpx; color: #fff; background: rgba(255, 255, 255, 0.14); font-size: 25rpx; }
.shop-progress-retry::after { border: none; }
