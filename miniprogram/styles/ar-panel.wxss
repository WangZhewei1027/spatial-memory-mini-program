@import "ar-theme.wxss";
.feature-panel { padding: 20rpx 32rpx 28rpx; }
.panel-heading { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; min-height: 72rpx; }
.panel-title { font-size: 28rpx; line-height: 40rpx; font-weight: 600; }
.feature-panel .panel-action {
  flex-shrink: 0;
  min-height: 88rpx;
  margin: -8rpx -12rpx -8rpx 0;
  padding: 0 12rpx;
  background: transparent;
  color: var(--ar-accent-text);
  font-size: 25rpx;
  line-height: 88rpx;
}
.panel-action::after, .activity-retry::after, .danmaku-send::after { border: none; }
.panel-action:active { opacity: 0.65; }
.retrieval-status { display: block; margin-top: 8rpx; font-size: 26rpx; line-height: 40rpx; overflow-wrap: break-word; }
.activity-status { display: block; padding: 8rpx 0; font-size: 24rpx; line-height: 36rpx; color: #c4c8c2; }
.activity-retry { margin: 8rpx 0 0; min-height: 88rpx; padding: 12rpx 20rpx; background: #343a32; color: #e5e9e1; font-size: 26rpx; }
.activity-selector { flex: 1; min-width: 0; }
.activity-picker { display: flex; align-items: center; min-height: 88rpx; }
.activity-name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.picker-chevron { width: 28rpx; height: 28rpx; margin-left: 12rpx; flex-shrink: 0; }
.input-counter { flex-shrink: 0; color: #b6beb3; font-size: 22rpx; font-variant-numeric: tabular-nums; }
.danmaku-composer { display: flex; align-items: center; gap: 16rpx; margin-top: 12rpx; }
.danmaku-input { flex: 1; min-width: 0; height: 88rpx; padding: 0 24rpx; border-radius: 12rpx; background: #363b34; color: #fff; font-size: 28rpx; }
.danmaku-placeholder { color: #bec7ba; }
.feature-panel .danmaku-send { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 88rpx; height: 88rpx; padding: 0; margin: 0; border-radius: 12rpx; background: #42633c; }
.feature-panel .danmaku-send[disabled] { background: #353a33; opacity: 0.45; }
.send-icon { width: 40rpx; height: 40rpx; }
