.page { padding: 16px; background: #f4f5f7; color: #18202c; min-height: 100vh; box-sizing: border-box; }
.status { display: block; font-size: 16px; font-weight: 600; margin-bottom: 12px; }
.error { display: block; color: #ad2525; margin-bottom: 12px; white-space: pre-wrap; word-break: break-all; }
.inference { position: fixed; left: -2px; top: -2px; width: 1px; height: 1px; opacity: .01; }
.camera { position: relative; background: #17202a; border-radius: 12px; overflow: hidden; }
.placeholder { position: absolute; top: 45%; width: 100%; text-align: center; color: #abb7c5; }
.actions { display: flex; flex-wrap: wrap; gap: 8px; margin: 12px 0; }
.actions button { margin: 0; }
.hint { display: block; color: #657284; font-size: 12px; margin: 8px 0; }
.reference { display: inline-block; padding: 4px 8px; border-radius: 6px; background: #e3e8ef; margin: 2px; font-size: 12px; }
.rank { display: flex; justify-content: space-between; background: white; padding: 8px; }
.result { background: white; padding: 12px; border-radius: 10px; margin-bottom: 8px; }
.result text { display: block; font-size: 12px; line-height: 1.7; }
.result .label { font-size: 14px; font-weight: 600; }
